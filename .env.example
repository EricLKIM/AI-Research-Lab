OPENAI_API_KEY=sk-your-key-here

# (선택) 커스텀 엔드포인트 — 사내 프록시, Azure OpenAI 호환 서버, 로컬 LLM 서버 등을
# 쓸 때만 채우세요. 비워두면 OpenAI 공식 엔드포인트(https://api.openai.com/v1)를 사용합니다.
# 예: OPENAI_API_BASE=https://my-proxy.example.com/v1
OPENAI_API_BASE=

# Reddit Data API (선택). Reddit 승인 및 OAuth 자격 증명을 받은 경우에만 설정하세요.
# REDDIT_USER_AGENT는 앱 이름·버전·Reddit 사용자명을 식별할 수 있게 작성합니다.
# 예: ai-research-lab:1.0 (by /u/your_reddit_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# X API v2 (선택). 공개 게시물 읽기용 Bearer Token입니다.
X_BEARER_TOKEN=

# YouTube Data API v3 (선택). 영상 검색은 기본 하루 100회까지입니다.
YOUTUBE_API_KEY=
