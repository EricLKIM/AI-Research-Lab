OPENAI_API_KEY=sk-your-key-here

# Optional custom endpoint for a proxy, Azure OpenAI-compatible server, or local LLM server.
# Leave blank to use the official OpenAI endpoint (https://api.openai.com/v1).
# Example: OPENAI_API_BASE=https://my-proxy.example.com/v1
OPENAI_API_BASE=

# Tavily Social (recommended, optional). One key can discover public Reddit/X
# discussions for the gossip allocation; direct platform credentials remain optional.
TAVILY_API_KEY=

# Optional Reddit Data API credentials. Configure these only after obtaining Reddit OAuth approval.
# REDDIT_USER_AGENT should identify the app name, version, and Reddit username.
# Example: ai-research-lab:1.0 (by /u/your_reddit_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Optional X API v2 bearer token for reading public posts.
X_BEARER_TOKEN=

# Optional YouTube Data API v3 key. Video search has a default daily quota of 100 requests.
YOUTUBE_API_KEY=
